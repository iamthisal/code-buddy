:root{--primary:{{ spec.theme.primary }};--background:{{ spec.theme.background }};--text:{{ spec.theme.text }};--muted:#687578;--line:#d8dfdf;font-family:{% if spec.theme.font == 'serif' %}Georgia,serif{% else %}Inter,Arial,sans-serif{% endif %};color:var(--text);background:var(--background)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit}button,input{font:inherit}.site-header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:20px clamp(24px,5vw,80px);border-bottom:1px solid var(--line)}.brand{font-size:20px;font-weight:800;text-decoration:none}.site-header nav{display:flex;flex-wrap:wrap;gap:20px}.site-header nav a{text-transform:capitalize;text-decoration:none;font-size:14px}.hero{min-height:420px;display:flex;align-items:center;background:var(--primary);color:white;padding:70px clamp(24px,8vw,120px)}.hero-inner{max-width:760px}.eyebrow{display:block;font-size:12px;font-weight:800;letter-spacing:.12em;margin-bottom:20px}.hero h1{font-size:clamp(40px,6vw,76px);line-height:1.04;margin:0 0 24px}.hero p{font-size:clamp(16px,2vw,21px);line-height:1.5;max-width:620px}.button{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:4px;padding:13px 20px;background:var(--text);color:var(--background);text-decoration:none;cursor:pointer;font-weight:700}.hero .button{background:white;color:#17252b;margin-top:14px}.content-section{padding:72px clamp(24px,8vw,120px);border-bottom:1px solid var(--line)}.section-inner{max-width:1100px;margin:auto}.content-section h2{font-size:clamp(30px,4vw,44px);margin:0 0 20px}.content-section p{line-height:1.6}.item-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-top:32px}.item{padding:24px;border:1px solid var(--line);border-radius:6px}.item h3{margin:0 0 8px}.item strong{color:var(--primary)}details{padding:16px 0;border-bottom:1px solid var(--line)}summary{cursor:pointer;font-weight:600}form{display:grid;gap:12px;max-width:400px}input{padding:12px;border:1px solid var(--line);border-radius:4px}footer{display:flex;justify-content:space-between;gap:20px;padding:32px clamp(24px,5vw,80px);font-size:14px}@media(max-width:650px){.site-header{align-items:flex-start;flex-direction:column}.hero{min-height:380px;padding-top:56px;padding-bottom:56px}footer{flex-direction:column}}
